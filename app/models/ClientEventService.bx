/**
 * Rules and rate limiting for client-published events.
 *
 * Client publishing is the one path where an untrusted party decides what goes on
 * the wire, so it is deliberately narrow:
 *
 *   - off unless the app opts in
 *   - private/presence channels only, never public ones
 *   - event names must start with `client-`, so a client can never impersonate a
 *     server-published event your handlers already trust
 *   - rate limited per connection
 *
 * The per-connection budget is a sliding one-second window held in the
 * application scope, matching the single-node assumption used elsewhere.
 */
class singleton {

	variables.STORE_KEY = "pulselyClientEventRates";
	variables.EVENT_PREFIX = "client-";
	variables.MAX_EVENTS_PER_SECOND = 10;
	variables.MAX_PAYLOAD_BYTES = 10240;

	function init() {
		ensureStore();
		return this;
	}

	string function eventPrefix() {
		return variables.EVENT_PREFIX;
	}

	numeric function maxEventsPerSecond() {
		return variables.MAX_EVENTS_PER_SECOND;
	}

	numeric function maxPayloadBytes() {
		return variables.MAX_PAYLOAD_BYTES;
	}

	boolean function isClientEventName( required string eventName ) {
		return eventName.startsWith( variables.EVENT_PREFIX );
	}

	boolean function isWithinSizeLimit( required string payload ) {
		return len( payload ) <= variables.MAX_PAYLOAD_BYTES;
	}

	/**
	 * Consume one unit of a connection's budget.
	 *
	 * @return true when the event may proceed.
	 */
	boolean function consume( required string connectionId ) {
		var store = ensureStore();
		var second = int( getTickCount() / 1000 );

		lock name="pulselyClientRate-#connectionId#" type="exclusive" timeout="5" {
			var record = store[ connectionId ] ?: { second : second, count : 0 };

			if ( record.second != second ) {
				record.second = second;
				record.count = 0;
			}

			if ( record.count >= variables.MAX_EVENTS_PER_SECOND ) {
				store[ connectionId ] = record;
				return false;
			}

			record.count++;
			store[ connectionId ] = record;
			return true;
		}
	}

	function release( required string connectionId ) {
		ensureStore().delete( connectionId );
	}

	/**
	 * Drops budgets for connections that have gone quiet, so the store does not
	 * grow with every socket the server has ever seen.
	 */
	numeric function purgeExpired() {
		var store = ensureStore();
		var cutoff = int( getTickCount() / 1000 ) - 60;
		var removed = 0;

		for ( var connectionId in store.keyArray() ) {
			if ( ( store[ connectionId ].second ?: 0 ) < cutoff ) {
				store.delete( connectionId );
				removed++;
			}
		}

		return removed;
	}

	function clearAll() {
		application[ variables.STORE_KEY ] = {};
	}

	private struct function ensureStore() {
		if ( !application.keyExists( variables.STORE_KEY ) ) {
			lock name="pulselyClientRateInit" type="exclusive" timeout="10" {
				if ( !application.keyExists( variables.STORE_KEY ) ) {
					application[ variables.STORE_KEY ] = {};
				}
			}
		}
		return application[ variables.STORE_KEY ];
	}

}
