/**
 * PBKDF2-HMAC-SHA256 password hashing.
 *
 * Stored format: pbkdf2${iterations}${saltHex}${hashHex}
 */
class singleton {

	variables.ITERATIONS = 210000;
	variables.KEY_BITS   = 256;
	variables.SALT_BYTES = 16;

	function init() {
		return this;
	}

	string function hash( required string plain ) {
		var salt = createObject( "java", "java.security.SecureRandom" ).init();
		var saltBytes = createObject( "java", "java.lang.reflect.Array" )
			.newInstance( createObject( "java", "java.lang.Byte" ).TYPE, variables.SALT_BYTES );
		salt.nextBytes( saltBytes );

		return "pbkdf2$#variables.ITERATIONS#$#bytesToHex( saltBytes )#$#derive( plain, saltBytes, variables.ITERATIONS )#";
	}

	/**
	 * Compares in constant time so a caller cannot learn the hash by timing.
	 */
	boolean function verify( required string plain, required string stored ) {
		var parts = stored.listToArray( "$" );
		if ( parts.len() != 4 || parts[ 1 ] != "pbkdf2" ) {
			return false;
		}

		var iterations = val( parts[ 2 ] );
		var saltBytes  = hexToBytes( parts[ 3 ] );
		var expected   = parts[ 4 ];

		if ( iterations <= 0 ) {
			return false;
		}

		return constantTimeEquals( lcase( expected ), lcase( derive( plain, saltBytes, iterations ) ) );
	}

	private string function derive( required string plain, required any saltBytes, required numeric iterations ) {
		var spec = createObject( "java", "javax.crypto.spec.PBEKeySpec" ).init(
			plain.toCharArray(),
			saltBytes,
			javacast( "int", iterations ),
			javacast( "int", variables.KEY_BITS )
		);
		var factory = createObject( "java", "javax.crypto.SecretKeyFactory" )
			.getInstance( "PBKDF2WithHmacSHA256" );
		return bytesToHex( factory.generateSecret( spec ).getEncoded() );
	}

	private string function bytesToHex( required any bytes ) {
		return lcase( binaryEncode( bytes, "hex" ) );
	}

	private any function hexToBytes( required string hex ) {
		return binaryDecode( hex, "hex" );
	}

	private boolean function constantTimeEquals( required string a, required string b ) {
		if ( a.len() != b.len() ) {
			return false;
		}
		var diff = 0;
		for ( var i = 1; i <= a.len(); i++ ) {
			diff = bitOr( diff, bitXor( ascii( a.mid( i, 1 ) ), ascii( b.mid( i, 1 ) ) ) );
		}
		return diff == 0;
	}

}
