/**
 * Every assignment here must be scoped to `variables`. In a BoxLang class an
 * unscoped assignment inside a function lands in that function's local scope,
 * so ColdBox reads nothing back and silently falls through to its defaults.
 */
class {

	function configure() {
		variables.coldbox = {
			appName                : "pulsely",
			// Dependencies install to lib/modules in this layout, which is outside
			// the ColdBox app root, so it has to be pointed at them explicitly.
			modulesExternalLocation: [ "/modules"],
			handlersIndexAutoReload: true,
			handlerCaching         : false,
			eventCaching           : false,
			defaultEvent           : "Home.index",
			requestStartHandler    : "",
			reinitPassword         : "",
			customErrorTemplate    : "/coldbox/system/exceptions/Whoops.cfm"
		};

		variables.environments = { development: "localhost,127\.0\.0\.1" };

		// ColdBox's own default LogBox config registers the console appender by
		// its short class name ("ConsoleAppender"), which Adobe/Lucee resolve via
		// an implicit search path. BoxLang's class resolver doesn't do that
		// implicit lookup, so it throws ClassNotFoundBoxLangException on boot -
		// use the fully-qualified path instead.
		variables.logBox = {
			appenders: { console: { class: "coldbox.system.logging.appenders.ConsoleAppender" } },
			root     : { levelmax: "INFO", appenders: "*" }
		};

		variables.moduleSettings = {
			cbcsrf: {
				// Verification is done in Dashboard.preHandler() rather than by the
				// module's auto-verifier. The verifier throws from an interceptor
				// during preProcess, which sits outside the event lifecycle, so the
				// exception handler cannot turn it into a friendly 403 — a user with
				// a stale tab would just get a 500.
				enableAutoVerifier: false,
				rotationTimeout   : 30
			}
		};

		variables.interceptors = [];

		variables.settings = {
			// Clock skew tolerance for trigger-API HMAC signatures.
			triggerAuthWindowSeconds: 600
		};
	}
}