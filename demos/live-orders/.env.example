# Copy to .env to point the demo at your own app instead of the dev seed.
# Find these on /dashboard/app/{appId}. Never commit the filled-in .env.

PULSELY_APP_ID=
PULSELY_APP_KEY=
PULSELY_APP_SECRET=

# The Pulsely server itself.
PULSELY_BASE_URL=http://127.0.0.1:8085
PULSELY_WS_URL=ws://127.0.0.1:8085/ws

# Port this demo serves on.
PORT=3000
