# ColdBox Name and Environment
APPNAME=pulsely
ENVIRONMENT=development

# BoxLang Environment
BOXLANG_DEBUG=true

# Database Information
DB_CONNECTIONSTRING=jdbc:mysql://127.0.0.1:3306/pulsely?useSSL=false&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useLegacyDatetimeCode=true&allowPublicKeyRetrieval=true
DB_DRIVER=MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pulsely
DB_USER=root
DB_PASSWORD=

# JWT Information
JWT_SECRET=

# S3 Information
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_DOMAIN=amazonaws.com
