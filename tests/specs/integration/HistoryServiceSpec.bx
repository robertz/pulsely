class extends="testbox.system.BaseSpec" {

	variables.DSN = "pulsely";
	variables.TEST_ACCOUNT = "cc000000000000000000000000000001";
	variables.TEST_APP     = "cc000000000000000000000000000002";

	function beforeAll() {
		variables.history = new app.models.HistoryService();

		queryExecute(
			"INSERT INTO accounts (id, email, name, password_hash, plan_id)
			 SELECT UNHEX(:acct), 'history-spec@test.local', 'History Spec', 'x', id
			 FROM plans WHERE name = 'Business'
			 ON DUPLICATE KEY UPDATE name = VALUES(name)",
			{ acct : variables.TEST_ACCOUNT },
			{ datasource : variables.DSN }
		);
		queryExecute(
			"INSERT INTO apps (id, account_id, name, app_key, app_secret)
			 VALUES (UNHEX(:app), UNHEX(:acct), 'History Spec App', 'historyspeckey', 'historyspecsecret')
			 ON DUPLICATE KEY UPDATE name = VALUES(name)",
			{ app : variables.TEST_APP, acct : variables.TEST_ACCOUNT },
			{ datasource : variables.DSN }
		);
	}

	function afterAll() {
		queryExecute( "DELETE FROM channel_messages WHERE app_id = UNHEX(:app)", { app : variables.TEST_APP }, { datasource : variables.DSN } );
		queryExecute( "DELETE FROM apps WHERE id = UNHEX(:app)", { app : variables.TEST_APP }, { datasource : variables.DSN } );
		queryExecute( "DELETE FROM accounts WHERE id = UNHEX(:acct)", { acct : variables.TEST_ACCOUNT }, { datasource : variables.DSN } );
	}

	private function reset() {
		queryExecute( "DELETE FROM channel_messages WHERE app_id = UNHEX(:app)", { app : variables.TEST_APP }, { datasource : variables.DSN } );
	}

	private function backdate( required string channel, required numeric hoursAgo ) {
		queryExecute(
			"UPDATE channel_messages SET created_at = DATE_SUB(NOW(3), INTERVAL :hrs HOUR)
			 WHERE app_id = UNHEX(:app) AND channel_name = :chan",
			{ app : variables.TEST_APP, chan : channel, hrs : hoursAgo },
			{ datasource : variables.DSN }
		);
	}

	function run() {

		describe( "record()", () => {

			beforeEach( () => reset() );

			it( "stores the event name and payload separately", () => {
				variables.history.record( variables.TEST_APP, "orders", "created", '{"id":42}' );

				var rows = queryExecute(
					"SELECT channel_name, event_name, payload FROM channel_messages WHERE app_id = UNHEX(:app)",
					{ app : variables.TEST_APP },
					{ datasource : variables.DSN }
				);

				expect( rows.recordCount ).toBe( 1 );
				expect( rows.channel_name[ 1 ] ).toBe( "orders" );
				expect( rows.event_name[ 1 ] ).toBe( "created" );
				expect( jsonDeserialize( rows.payload[ 1 ] ).id ).toBe( 42 );
			} );

			/**
			 * Storing the whole envelope nested it under "data" again on replay, so
			 * subscribers saw data.data.  Only the data payload belongs here.
			 */
			it( "stores only the data payload, not the whole envelope", () => {
				variables.history.record( variables.TEST_APP, "orders", "created", '{"hello":"world"}' );

				var replayed = variables.history.getRecent( variables.TEST_APP, "orders", 24 );

				expect( replayed.len() ).toBe( 1 );
				expect( replayed[ 1 ].data ).toHaveKey( "hello" );
				expect( replayed[ 1 ].data ).notToHaveKey( "data" );
				expect( replayed[ 1 ].data ).notToHaveKey( "event" );
			} );

		} );

		describe( "getRecent()", () => {

			beforeEach( () => reset() );

			it( "returns replay envelopes shaped like live messages", () => {
				variables.history.record( variables.TEST_APP, "orders", "created", '{"id":1}' );

				var replayed = variables.history.getRecent( variables.TEST_APP, "orders", 24 );

				expect( replayed[ 1 ] ).toHaveKey( "event" );
				expect( replayed[ 1 ] ).toHaveKey( "data" );
				expect( replayed[ 1 ] ).toHaveKey( "created_at" );
				expect( replayed[ 1 ].event ).toBe( "created" );
				expect( replayed[ 1 ].replayed ).toBeTrue( "subscribers must be able to tell replay from live" );
			} );

			it( "returns oldest first so replay order matches live order", () => {
				for ( var i = 1; i <= 3; i++ ) {
					variables.history.record( variables.TEST_APP, "orders", "e#i#", '{"i":#i#}' );
					sleep( 5 );
				}

				var replayed = variables.history.getRecent( variables.TEST_APP, "orders", 24 );

				expect( replayed.len() ).toBe( 3 );
				expect( replayed[ 1 ].event ).toBe( "e1" );
				expect( replayed[ 3 ].event ).toBe( "e3" );
			} );

			it( "keeps channels separate", () => {
				variables.history.record( variables.TEST_APP, "orders", "created", '{}' );
				variables.history.record( variables.TEST_APP, "invoices", "created", '{}' );

				expect( variables.history.getRecent( variables.TEST_APP, "orders", 24 ).len() ).toBe( 1 );
			} );

			it( "returns nothing when history is disabled for the plan", () => {
				variables.history.record( variables.TEST_APP, "orders", "created", '{}' );

				expect( variables.history.getRecent( variables.TEST_APP, "orders", 0 ) ).toBeEmpty();
			} );

			it( "excludes messages older than the retention window", () => {
				variables.history.record( variables.TEST_APP, "stale", "created", '{}' );
				backdate( "stale", 48 );

				expect( variables.history.getRecent( variables.TEST_APP, "stale", 24 ) ).toBeEmpty();
				expect( variables.history.getRecent( variables.TEST_APP, "stale", 72 ).len() ).toBe( 1 );
			} );

			it( "caps how many messages it replays", () => {
				for ( var i = 1; i <= 6; i++ ) {
					variables.history.record( variables.TEST_APP, "bulk", "e#i#", '{}' );
				}

				expect( variables.history.getRecent( variables.TEST_APP, "bulk", 24, 3 ).len() ).toBe( 3 );
			} );

			it( "returns the newest messages when capped, still oldest-first", () => {
				for ( var i = 1; i <= 5; i++ ) {
					variables.history.record( variables.TEST_APP, "bulk", "e#i#", '{}' );
					sleep( 5 );
				}

				var replayed = variables.history.getRecent( variables.TEST_APP, "bulk", 24, 2 );

				expect( replayed[ 1 ].event ).toBe( "e4" );
				expect( replayed[ 2 ].event ).toBe( "e5" );
			} );

		} );

		describe( "purgeExpired()", () => {

			beforeEach( () => reset() );

			it( "removes messages past the plan's retention and keeps the rest", () => {
				variables.history.record( variables.TEST_APP, "fresh", "created", '{}' );
				variables.history.record( variables.TEST_APP, "old", "created", '{}' );
				backdate( "old", 48 );

				variables.history.purgeExpired();

				var remaining = queryExecute(
					"SELECT channel_name FROM channel_messages WHERE app_id = UNHEX(:app)",
					{ app : variables.TEST_APP },
					{ datasource : variables.DSN }
				);

				expect( remaining.recordCount ).toBe( 1 );
				expect( remaining.channel_name[ 1 ] ).toBe( "fresh" );
			} );

		} );

	}

}
