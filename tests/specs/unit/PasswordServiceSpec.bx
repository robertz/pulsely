class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.pw = new app.models.PasswordService();
	}

	function run() {

		describe( "hash()", () => {

			it( "emits the documented pbkdf2 format", () => {
				var stored = variables.pw.hash( "correct horse battery staple" );
				var parts = stored.listToArray( "$" );

				expect( parts.len() ).toBe( 4 );
				expect( parts[ 1 ] ).toBe( "pbkdf2" );
				expect( parts[ 2 ] ).toBe( "210000" );
				expect( parts[ 3 ] ).toMatch( "^[0-9a-f]{32}$" );
				expect( parts[ 4 ] ).toMatch( "^[0-9a-f]{64}$" );
			} );

			it( "salts, so the same password hashes differently every time", () => {
				expect( variables.pw.hash( "same-password" ) ).notToBe( variables.pw.hash( "same-password" ) );
			} );

		} );

		describe( "verify()", () => {

			it( "accepts the correct password", () => {
				var stored = variables.pw.hash( "s3cret-p@ss" );

				expect( variables.pw.verify( "s3cret-p@ss", stored ) ).toBeTrue();
			} );

			it( "rejects the wrong password", () => {
				var stored = variables.pw.hash( "s3cret-p@ss" );

				expect( variables.pw.verify( "s3cret-p@sS", stored ) ).toBeFalse();
				expect( variables.pw.verify( "", stored ) ).toBeFalse();
			} );

			it( "verifies a hash generated outside the app", () => {
				// Generated with python hashlib.pbkdf2_hmac for 'pulsely'; this is
				// the seeded dev credential, so the seed and the verifier cannot drift.
				var seeded = "pbkdf2$210000$1ca174a3ae02bc4b1b6e568de2b7bfbc$7fb0bfa64eec075e56aada501c6eb2ef47dcc3849eb5d9eade88485129112f53";

				expect( variables.pw.verify( "pulsely", seeded ) ).toBeTrue();
				expect( variables.pw.verify( "not-it", seeded ) ).toBeFalse();
			} );

			it( "honours the iteration count recorded in the hash", () => {
				var stored = variables.pw.hash( "iter-test" );
				var tampered = stored.replace( "$210000$", "$1000$" );

				expect( variables.pw.verify( "iter-test", tampered ) ).toBeFalse();
			} );

			it( "rejects malformed stored values without throwing", () => {
				for ( var bad in [ "", "not-a-hash", "pbkdf2$210000$onlythree", "bcrypt$1$2$3", "pbkdf2$abc$ff$ff" ] ) {
					expect( variables.pw.verify( "anything", bad ) ).toBeFalse( "should reject [#bad#]" );
				}
			} );

		} );

	}

}
